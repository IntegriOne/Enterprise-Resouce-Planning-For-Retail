APP_ENV=development
HRM_SERVICE_NAME=integrione-human-resource
HRM_GRPC_HOST=127.0.0.1
HRM_GRPC_PORT=9003
HRM_GRPC_TLS_CERT_FILE=/etc/integrione/certs/hrm.crt
HRM_GRPC_TLS_KEY_FILE=/etc/integrione/certs/hrm.key
HRM_GRPC_TLS_CA_FILE=/etc/integrione/certs/ca.crt
HRM_GRPC_TLS_SERVER_NAME=human-resource
HRM_GATEWAY_HMAC_SECRET_FILE=/run/secrets/gateway_hmac
HRM_DB_HOST=127.0.0.1
HRM_DB_PORT=6543
HRM_DB_USER=hrm
HRM_DB_PASSWORD_FILE=/run/secrets/hrm_db_password
HRM_DB_NAME=human_resource
HRM_DB_SSLMODE=verify-full
HRM_DB_SSLROOTCERT=/etc/integrione/certs/postgres-ca.crt
HRM_DB_MAX_OPEN_CONNS=20
HRM_DB_MAX_IDLE_CONNS=5
HRM_DB_CONN_MAX_LIFETIME=30m
HRM_REDIS_ADDR=127.0.0.1:6379
HRM_REDIS_USERNAME=hrm_reader
HRM_REDIS_PASSWORD_FILE=/run/secrets/hrm_redis_password
HRM_REDIS_CA_CERT_PATH=/etc/integrione/certs/redis-ca.crt
HRM_REDIS_SERVER_NAME=redis
HRM_REDIS_POOL_SIZE=16
HRM_REDIS_MIN_IDLE_CONNS=0
HRM_REDIS_DIAL_TIMEOUT=2s
HRM_REDIS_READ_TIMEOUT=1s
HRM_REDIS_WRITE_TIMEOUT=1s
HRM_SECURITY_NAMESPACE=development
HRM_STARTUP_TIMEOUT=60s
HRM_SHUTDOWN_TIMEOUT=10s
HRM_OUTBOX_MODE=standby
HRM_OUTBOX_POLL_INTERVAL=5s
HRM_OUTBOX_PUBLISH_TIMEOUT=5s
HRM_OUTBOX_MAX_ATTEMPTS=20
# Isi URL dan berkas secret HMAC hanya saat mode webhook diaktifkan.
HRM_OUTBOX_WEBHOOK_URL=
HRM_OUTBOX_WEBHOOK_HMAC_SECRET_FILE=
# Integrasi internal gRPC ke layanan Enterprise Foundation (badan hukum, unit, lokasi, party).
HRM_EF_ENABLED=false
HRM_EF_GRPC_TARGET=127.0.0.1:9002
HRM_EF_GRPC_TIMEOUT=5s
HRM_EF_HMAC_SECRET_FILE=/run/secrets/ef_hmac

# Klien privat mTLS IAM untuk pengecekan mandat requisition.
HRM_IAM_MANDATE_TARGET=
HRM_IAM_MANDATE_SERVER_NAME=
HRM_IAM_MANDATE_CERT_FILE=
HRM_IAM_MANDATE_KEY_FILE=
HRM_IAM_MANDATE_CA_FILE=

# Listener privat opsional untuk workload IAM. Isi semua nilai untuk mengaktifkan.
HRM_TERMINATION_ACCESS_ADDR=
HRM_TERMINATION_ACCESS_CERT_FILE=
HRM_TERMINATION_ACCESS_KEY_FILE=
HRM_TERMINATION_ACCESS_CLIENT_CA_FILE=
