# Konfigurasi lokal untuk layanan Enterprise Foundation gRPC + PostgreSQL (salin ke .env bila ingin override).
TZ=Asia/Jakarta
APP_ENV=development
EF_SERVICE_NAME=integrione-enterprise-foundation
EF_SHUTDOWN_TIMEOUT_SECONDS=10

# Endpoint dan port gRPC server Enterprise Foundation.
EF_GRPC_HOST=0.0.0.0
EF_GRPC_PORT=9002
EF_GRPC_URL=127.0.0.1:9002

# Koneksi dan port PostgreSQL Enterprise Foundation (development & testing terisolasi).
EF_POSTGRES_HOST=127.0.0.1
EF_POSTGRES_PORT=5432
EF_POSTGRES_USER=postgres
EF_POSTGRES_PASSWORD=change_me_local_dev_password
EF_POSTGRES_DB=enterprise_foundation
EF_DATABASE_DSN="postgres://postgres:change_me_local_dev_password@127.0.0.1:5432/enterprise_foundation?sslmode=disable&TimeZone=Asia/Jakarta"
EF_TEST_DATABASE_DSN="postgres://postgres:change_me_local_dev_password@127.0.0.1:5432/enterprise_foundation_test?sslmode=disable&TimeZone=Asia/Jakarta"

# Bukti HMAC internal Gateway untuk propagasi identitas pemanggil tepercaya (wajib min 32 byte di production).
EF_INTERNAL_GATEWAY_HMAC_SECRET=change_me_internal_gateway_hmac_secret_min_32_bytes

# Konfigurasi worker relay outbox asinkron (default standby sampai target konsumen webhook tersedia).
EF_OUTBOX_MODE=standby
EF_OUTBOX_WEBHOOK_URL=
EF_OUTBOX_WEBHOOK_HMAC_SECRET=
EF_OUTBOX_WEBHOOK_REQUIRE_HTTPS=false
EF_OUTBOX_WEBHOOK_TIMEOUT_SECONDS=5
EF_OUTBOX_POLL_INTERVAL_MS=5000
EF_OUTBOX_BATCH_SIZE=25
EF_OUTBOX_MAX_ATTEMPTS=20
EF_OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
EF_OUTBOX_CLEANUP_INTERVAL_MINUTES=60
EF_OUTBOX_RETENTION_HOURS=168
