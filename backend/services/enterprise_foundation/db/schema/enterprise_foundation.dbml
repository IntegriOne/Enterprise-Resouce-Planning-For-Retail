// ============================================================================
// INTEGRIONE — ENTERPRISE FOUNDATION & SHARED MASTER DATA
// ============================================================================
// Dialek Basis Data : PostgreSQL 18 (konsisten dengan IAM `gen_random_uuid()`)
// Model Arsitektur  : Single-Company Retail ERP (13 Management Aktif, Manufacturing PAUSED)
// Skala Target      : Perusahaan ritel ~10-50 karyawan (umumnya 1 kantor utama, 1 gudang,
//                     cabang terbatas) beserta mitra Supplier & Vendor.
//
// FOKUS INTI (RINGKAS, TERKONEKSI KE IAM, TANPA OVER-ENGINEERING):
// 1. Struktur Internal Perusahaan:
//    - legal_entities           : Badan hukum perusahaan (PT/CV, NIB, NPWP/PKP, alamat akta)
//                                 --> target `scope_type = 'legal_entity'` di IAM.
//    - organization_units       : Divisi/departemen/tim kerja internal (UUID stabil)
//                                 --> target `scope_type = 'organization_unit'` di IAM.
//    - locations                : Kantor utama, gudang, toko retail/cabang
//                                 --> target `scope_type = 'facility'` di IAM.
// 2. Mitra Bisnis Eksternal (Supplier, Vendor, Pelanggan B2B, dll.):
//    - parties                  : Master perusahaan/perorangan mitra + status + NPWP/PKP ringkas.
//    - party_roles              : Pemisahan peran eksplisit `supplier` vs `vendor` (+ peran lain)
//                                 --> terhubung ke `scope_type = 'supplier_party' / 'vendor_party'` IAM.
//    - party_contacts           : Narahubung/PIC mitra + referensi logis `iam_user_id` (`iam.users.id`)
//                                 beserta status akses portal agar PIC login sebagai manusia IAM.
//    - party_addresses          : Alamat kantor/penagihan vs gudang/workshop mitra.
// 3. Alamat Bersama & Sinkronisasi Lintas Service:
//    - addresses                : Master alamat fisik bersama (internal & mitra eksternal).
//    - foundation_outbox_events : Antrean outbox transaksional untuk memberitahu IAM, Procurement,
//                                 WMS, dan HRM saat status entity/unit/lokasi/party/PIC berubah.
//
// BATASAN DOMAIN (BOUNDED CONTEXT — agents/boundary.md & agents/users.md):
// - Dilarang membuat FK SQL lintas database (hanya UUID logis ke `iam.users.id` & `hrm` worker).
// - Akun login, password, role, dan scope grant 100% dimiliki oleh database `iam`.
// - Karyawan/kontrak/payroll dikelola HRM; kualifikasi/PO di Procurement; rekening AP di Finance.
// - Pembeli ritel B2C Web Commerce cukup memakai `iam.users` + modul Commerce, tidak masuk `parties`.
// ============================================================================

Project integrione_enterprise_foundation {
  database_type: 'PostgreSQL'
  Note: 'Skema inti Enterprise Foundation IntegriOne yang ramping untuk skala 10-50 staf (1 kantor utama, 1 gudang), mitra Supplier & Vendor, serta integrasi scope IAM.'
}

// ============================================================================
// 1. ENUMS
// ============================================================================

enum legal_entity_status {
  pending [note: 'Badan hukum dalam proses pendirian atau verifikasi awal']
  active [note: 'Badan hukum aktif beroperasi secara legal']
  suspended [note: 'Operasional badan hukum dibekukan sementara']
  dissolved [note: 'Badan hukum resmi dibubarkan / tidak beroperasi lagi']
}

enum org_unit_kind {
  division [note: 'Divisi utama (opsional bila organisasi cukup kecil)']
  department [note: 'Departemen operasional (misal: Finance, Procurement, Warehouse, HR, Commerce)']
  team [note: 'Tim kerja atau unit operasional kecil']
  branch [note: 'Unit operasional cabang atau toko']
  other [note: 'Struktur unit organisasi internal lainnya']
}

enum location_kind {
  headquarters [note: 'Kantor utama administrasi dan operasional pusat']
  warehouse [note: 'Gudang penyimpanan bahan baku maupun barang jadi']
  retail_store [note: 'Toko retail, showroom, atau gerai penjualan fisik']
  branch_office [note: 'Kantor cabang operasional fisik tambahan']
}

enum party_kind {
  organization [note: 'Badan usaha atau unit konveksi (PT, CV, Firma, Koperasi, UD)']
  individual [note: 'Mitra perorangan (vendor perorangan, supplier perorangan, pekerja lepas/konsultan)']
  financial_entity [note: 'Bank atau lembaga keuangan mitra']
  government_body [note: 'Instansi pemerintah / otoritas pajak bila diperlukan']
}

enum party_status {
  pending_verification [note: 'Mitra baru didaftarkan, menunggu verifikasi data awal']
  active [note: 'Mitra aktif dan sah untuk bertransaksi serta diakses PIC portalnya']
  suspended [note: 'Mitra dibekukan sementara; transaksi baru & akses portal ditahan (fail-closed)']
  inactive [note: 'Mitra sudah tidak bekerja sama lagi']
}

enum party_role_kind {
  supplier [note: 'Pemasok bahan baku atau barang dagang -> scope IAM supplier_party']
  vendor [note: 'Vendor penyedia jasa atau mitra operasional (misal: jasa produksi/maklun, pemeliharaan, layanan teknis) -> scope IAM vendor_party']
  customer_b2b [note: 'Pelanggan grosir/korporasi B2B yang membutuhkan NPWP dan alamat penagihan resmi']
  carrier [note: 'Ekspedisi, kurir, atau mitra pengiriman logistik']
  financial_institution [note: 'Bank atau penyedia jasa keuangan']
  other [note: 'Peran mitra bisnis khusus lainnya']
}

enum portal_access_status {
  none [note: 'Kontak/narahubung biasa tanpa akun login IAM']
  pending_link [note: 'PIC sudah ditautkan ke iam_user_id, menunggu verifikasi/aktivasi akses portal']
  active [note: 'PIC resmi aktif dan boleh menggunakan portal /supplier atau /vendor sesuai role IAM']
  revoked [note: 'Mandat PIC untuk mewakili mitra dicabut; memicu validasi ulang akses di IAM']
}

enum address_usage_kind {
  registered_office [note: 'Alamat resmi domisili hukum / NPWP']
  headquarters [note: 'Alamat kantor operasional utama mitra']
  billing [note: 'Alamat penagihan dan pengiriman faktur/invoice']
  shipping [note: 'Alamat pengiriman atau pengambilan barang (gudang / lokasi operasional mitra)']
  other [note: 'Alamat peruntukan khusus lainnya']
}

enum outbox_status {
  pending [note: 'Event perubahan master data belum dikirim/diproses consumer']
  effective [note: 'Event sudah berhasil diproses oleh consumer terkait']
  failed [note: 'Event gagal melewati batas percobaan ulang dan butuh audit/pemulihan']
}

// ============================================================================
// 2. MASTER ALAMAT BERSAMA
// ============================================================================

Table addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  label varchar(120) [note: 'Label singkat alamat (misal: Kantor Utama Jakarta, Gudang Bandung, Workshop Pak Budi)']
  address_line_1 varchar(240) [not null, note: 'Nama jalan, nomor bangunan/ruko, RT/RW']
  address_line_2 varchar(240) [note: 'Nama gedung/kompleks, kelurahan, kecamatan']
  city varchar(120) [not null, note: 'Kota atau kabupaten (misal: Jakarta Selatan, Bandung)']
  province varchar(120) [note: 'Provinsi atau wilayah administratif (misal: DKI Jakarta, Jawa Barat)']
  postal_code varchar(20) [note: 'Kode pos']
  country_code char(2) [not null, default: 'ID', note: 'Kode negara ISO 3166-1 alpha-2']
  formatted_address text [note: 'Alamat lengkap siap cetak untuk PO, surat jalan, dan faktur']
  latitude numeric(10,7) [note: 'Koordinat lintang opsional']
  longitude numeric(10,7) [note: 'Koordinat bujur opsional']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Master alamat fisik geografis yang dipakai bersama oleh badan hukum internal, lokasi fasilitas, dan mitra eksternal.'

  indexes {
    (country_code, postal_code) [name: 'ix_addresses_country_postal']
    (city, province) [name: 'ix_addresses_city_province']
  }

  checks {
    `latitude IS NULL OR latitude BETWEEN -90 AND 90` [name: 'ck_addresses_latitude']
    `longitude IS NULL OR longitude BETWEEN -180 AND 180` [name: 'ck_addresses_longitude']
  }
}

// ============================================================================
// 3. PILAR INTERNAL PERUSAHAAN (SINGLE-COMPANY + 1 KANTOR + 1 GUDANG)
// ============================================================================

Table legal_entities {
  id uuid [pk, default: `gen_random_uuid()`]
  parent_legal_entity_id uuid [note: 'Induk badan hukum opsional bila suatu saat terdapat lebih dari 1 PT/CV']
  entity_code varchar(60) [not null, note: 'Kode unik badan hukum perusahaan (misal: INTEGRIONE, PT-IGR)']
  legal_name varchar(240) [not null, note: 'Nama resmi berbadan hukum sesuai akta (misal: PT IntegriOne Ritel Nusantara)']
  trading_name varchar(240) [note: 'Nama merek dagang / komersial (misal: IntegriOne)']
  legal_form varchar(40) [note: 'Bentuk usaha: PT, PT Perorangan, CV, Firma, UD']
  is_primary_operating_entity boolean [not null, default: false, note: 'Menandai badan hukum operasional utama pada instalasi ERP ini']
  status legal_entity_status [not null, default: 'active']
  jurisdiction_country_code char(2) [not null, default: 'ID', note: 'Negara domisili hukum (ISO 3166-1 alpha-2)']
  nib varchar(60) [note: 'Nomor Induk Berusaha (OSS RBA) perusahaan']
  tax_id_number varchar(32) [note: 'NPWP resmi perusahaan (15/16 digit) untuk dokumen PO & Faktur Pajak']
  is_pkp boolean [not null, default: false, note: 'Menandai status Pengusaha Kena Pajak (PKP) internal']
  registered_address_id uuid [note: 'Referensi ke alamat domisili resmi sesuai akta/NPWP di tabel addresses']
  fiscal_year_start_month smallint [not null, default: 1, note: 'Bulan awal tahun buku akuntansi (1 = Januari s.d. 12 = Desember)']
  incorporation_date date [note: 'Tanggal pendirian / pengesahan badan hukum']
  dissolution_date date [note: 'Tanggal pembubaran resmi bila status = dissolved']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Badan hukum resmi milik perusahaan (umumnya 1 baris utama untuk skala 10-50 orang). Target `scope_id` untuk `scope_type = legal_entity` di IAM.'

  indexes {
    entity_code [name: 'uq_legal_entities_code', note: 'Partial unique index PostgreSQL: UNIQUE (entity_code) WHERE (deleted_at IS NULL)']
    is_primary_operating_entity [name: 'uq_legal_entities_primary_operating', note: 'Partial unique index PostgreSQL: UNIQUE (is_primary_operating_entity) WHERE (is_primary_operating_entity = TRUE AND deleted_at IS NULL)']
    tax_id_number [name: 'uq_legal_entities_tax_id', note: 'Partial unique index PostgreSQL: UNIQUE (tax_id_number) WHERE (tax_id_number IS NOT NULL AND deleted_at IS NULL)']
    parent_legal_entity_id [name: 'ix_legal_entities_parent']
    status [name: 'ix_legal_entities_status']
    deleted_at [name: 'ix_legal_entities_deleted_at']
  }

  checks {
    `parent_legal_entity_id IS NULL OR parent_legal_entity_id <> id` [name: 'ck_legal_entities_not_self_parent']
    `fiscal_year_start_month BETWEEN 1 AND 12` [name: 'ck_legal_entities_fiscal_month']
    `dissolution_date IS NULL OR incorporation_date IS NULL OR dissolution_date >= incorporation_date` [name: 'ck_legal_entities_dates']
  }
}

Table organization_units {
  id uuid [pk, default: `gen_random_uuid()`]
  legal_entity_id uuid [not null, note: 'Badan hukum tempat unit organisasi ini bernaung']
  parent_unit_id uuid [note: 'Unit atasan langsung opsional (hierarki sederhana tanpa tabel graf terpisah)']
  primary_location_id uuid [note: 'Lokasi fasilitas fisik utama tempat unit ini bekerja (misal: Kantor Utama atau Gudang Utama)']
  unit_code varchar(60) [not null, note: 'Kode unik unit kerja (misal: MGMT, FIN, PROC, WH-MAIN, HR, ECOM)']
  name varchar(180) [not null, note: 'Nama departemen/tim internal (misal: Tim Gudang, Keuangan, Pengadaan)']
  unit_kind org_unit_kind [not null, default: 'department']
  cost_center_code varchar(60) [note: 'Kode pusat biaya opsional untuk referensi Finance']
  head_person_id uuid [note: 'Referensi logis opsional ke worker_id di HRM untuk kepala/lead unit (tanpa FK lintas DB)']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Struktur departemen, tim, dan cabang internal perusahaan (skala 10-50 orang). UUID `id` dijaga stabil karena menjadi target `scope_id` untuk `scope_type = organization_unit` di IAM.'

  indexes {
    (legal_entity_id, unit_code) [name: 'uq_organization_units_entity_code', note: 'Partial unique index PostgreSQL: UNIQUE (legal_entity_id, unit_code) WHERE (deleted_at IS NULL)']
    (legal_entity_id, is_active) [name: 'ix_organization_units_entity_active']
    parent_unit_id [name: 'ix_organization_units_parent']
    primary_location_id [name: 'ix_organization_units_location']
    deleted_at [name: 'ix_organization_units_deleted_at']
  }

  checks {
    `parent_unit_id IS NULL OR parent_unit_id <> id` [name: 'ck_organization_units_not_self_parent']
  }
}

Table locations {
  id uuid [pk, default: `gen_random_uuid()`]
  legal_entity_id uuid [not null, note: 'Badan hukum pemilik/pengelola fasilitas ini']
  parent_location_id uuid [note: 'Lokasi induk opsional (misal: area gudang di dalam kompleks yang sama)']
  address_id uuid [note: 'Alamat fisik lokasi pada master addresses']
  location_code varchar(60) [not null, note: 'Kode unik fasilitas (misal: HQ-MAIN, WH-MAIN, STORE-01)']
  name varchar(200) [not null, note: 'Nama fasilitas fisik (misal: Kantor Utama, Gudang Utama)']
  location_kind location_kind [not null, default: 'warehouse']
  phone varchar(60) [note: 'Nomor telepon / WhatsApp operasional lokasi']
  timezone varchar(80) [not null, default: 'Asia/Jakarta']
  operational_attributes jsonb [not null, default: `'{}'::jsonb`, note: 'Atribut ringan fasilitas untuk WMS/operasional (misal: jam operasional, luas m2, catatan bongkar muat)']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Daftar fasilitas fisik perusahaan (umumnya 1 kantor utama + 1 gudang, dan toko cabang bila ada). Target `scope_id` untuk `scope_type = facility` di IAM serta rujukan fasilitas di WMS.'

  indexes {
    location_code [name: 'uq_locations_code', note: 'Partial unique index PostgreSQL: UNIQUE (location_code) WHERE (deleted_at IS NULL)']
    (legal_entity_id, location_kind, is_active) [name: 'ix_locations_entity_kind_active']
    parent_location_id [name: 'ix_locations_parent']
    address_id [name: 'ix_locations_address']
    deleted_at [name: 'ix_locations_deleted_at']
  }

  checks {
    `parent_location_id IS NULL OR parent_location_id <> id` [name: 'ck_locations_not_self_parent']
  }
}

// ============================================================================
// 4. PILAR MITRA EKSTERNAL (SUPPLIER, VENDOR, & REKANAN LAIN)
// ============================================================================

Table parties {
  id uuid [pk, default: `gen_random_uuid()`]
  partner_code varchar(60) [not null, note: 'Kode unik mitra bisnis (misal: SUP-0001, VND-0001, B2B-0001)']
  party_kind party_kind [not null, default: 'organization', note: 'organization (PT/CV/Konveksi), individual (perorangan), financial_entity, government_body']
  display_name varchar(240) [not null, note: 'Nama umum / dagang mitra (misal: CV Tekstil Jaya, Vendor Maju Jaya)']
  legal_name varchar(240) [note: 'Nama resmi sesuai akta/NPWP untuk kontrak, PO, dan faktur']
  email varchar(255) [note: 'Email resmi kantor/admin mitra']
  phone varchar(60) [note: 'Nomor telepon / WhatsApp bisnis utama mitra']
  website_url varchar(500) [note: 'Website atau tautan profil bisnis mitra (opsional)']
  tax_id_number varchar(32) [note: 'NPWP atau NIK sebagai NPWP (15/16 digit) untuk faktur pajak & bukti potong PPh']
  tax_registered_name varchar(240) [note: 'Nama wajib pajak yang tertera pada kartu NPWP / SPPKP']
  is_pkp boolean [not null, default: false, note: 'Menandai apakah mitra berstatus Pengusaha Kena Pajak (PKP)']
  is_tax_exempt boolean [not null, default: false, note: 'Menandai pembebasan pemotongan/pungutan pajak (SKB)']
  tax_exemption_reason text [note: 'Dasar atau nomor surat pembebasan pajak bila is_tax_exempt = TRUE']
  tax_verified_at timestamptz [note: 'Waktu validasi NPWP/status pajak oleh tim internal']
  preferred_language varchar(20) [not null, default: 'id']
  status party_status [not null, default: 'pending_verification', note: 'Lifecycle administratif mitra: pending_verification, active, suspended, inactive']
  notes text [note: 'Catatan operasional singkat mengenai mitra']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Direktori master mitra bisnis eksternal (Supplier, Vendor, Pelanggan B2B, Kurir, Bank). Tidak memuat karyawan internal ataupun pembeli ritel B2C Web Commerce.'

  indexes {
    partner_code [name: 'uq_parties_partner_code', note: 'Partial unique index PostgreSQL: UNIQUE (partner_code) WHERE (deleted_at IS NULL)']
    tax_id_number [name: 'uq_parties_tax_id_number', note: 'Partial unique index PostgreSQL: UNIQUE (tax_id_number) WHERE (tax_id_number IS NOT NULL AND deleted_at IS NULL)']
    (party_kind, status) [name: 'ix_parties_kind_status']
    display_name [name: 'ix_parties_display_name', note: 'Dapat ditambah GIN pg_trgm pada migrasi SQL 000001 bila dibutuhkan autocomplete substring']
    deleted_at [name: 'ix_parties_deleted_at']
  }

  checks {
    `is_tax_exempt = FALSE OR tax_exemption_reason IS NOT NULL` [name: 'ck_parties_tax_exemption_reason']
  }
}

Table party_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  party_id uuid [not null, note: 'Mitra bisnis pada tabel parties']
  role party_role_kind [not null, note: 'supplier (pemasok barang/bahan), vendor (penyedia jasa/mitra operasional), customer_b2b, carrier, financial_institution, other']
  is_active boolean [not null, default: true, note: 'Menandai apakah peran mitra ini sedang aktif']
  reference_note varchar(200) [note: 'Nomor PKS/MOU ringkas atau catatan ruang lingkup (detail kontrak di Procurement)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Memisahkan secara eksplisit peran Supplier (`supplier` -> IAM `supplier_party`) dan Vendor (`vendor` -> IAM `vendor_party`), serta mengizinkan 1 mitra merangkap kedua peran.'

  indexes {
    (party_id, role) [unique, name: 'uq_party_roles_party_role']
    (role, is_active) [name: 'ix_party_roles_role_active']
  }
}

Table party_contacts {
  id uuid [pk, default: `gen_random_uuid()`]
  party_id uuid [not null, note: 'Mitra bisnis tempat narahubung/PIC ini bertugas']
  iam_user_id uuid [note: 'Referensi logis ke `users.id` di database IAM (tanpa FK SQL lintas DB) bila PIC ini memiliki akun portal /supplier atau /vendor']
  full_name varchar(200) [not null, note: 'Nama lengkap PIC / narahubung mitra']
  job_title varchar(120) [note: 'Peran/jabatan di perusahaan mitra (misal: Pemilik Konveksi, Admin Penjualan, Kepala Produksi)']
  contact_role varchar(60) [not null, default: 'general', note: 'owner, sales, billing_finance, production_pic, logistics, general']
  email varchar(255) [note: 'Email kerja PIC']
  phone varchar(60) [note: 'Nomor HP / WhatsApp kerja PIC']
  portal_access_status portal_access_status [not null, default: 'none', note: 'Status mandat perwakilan mitra: none (kontak biasa), pending_link, active, revoked']
  is_primary boolean [not null, default: false, note: 'Penanda PIC utama untuk mitra terkait']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Daftar narahubung/PIC resmi mitra sekaligus jembatan menuju akun manusia IAM (`iam_user_id`). Keputusan grant/role tetap di IAM (`supplier_party`/`vendor_party`), sedangkan keabsahan mandat PIC atas `party_id` diverifikasi dari sini.'

  indexes {
    (party_id, iam_user_id) [name: 'uq_party_contacts_party_iam_user', note: 'Partial unique index PostgreSQL: UNIQUE (party_id, iam_user_id) WHERE (iam_user_id IS NOT NULL AND deleted_at IS NULL)']
    iam_user_id [name: 'ix_party_contacts_iam_user', note: 'Partial index PostgreSQL: (iam_user_id) WHERE (iam_user_id IS NOT NULL AND deleted_at IS NULL)']
    (party_id, contact_role, is_primary, is_active) [name: 'ix_party_contacts_party_lookup']
    deleted_at [name: 'ix_party_contacts_deleted_at']
  }

  checks {
    `email IS NOT NULL OR phone IS NOT NULL OR iam_user_id IS NOT NULL` [name: 'ck_party_contacts_has_channel_or_user']
    `(iam_user_id IS NULL AND portal_access_status = 'none') OR (iam_user_id IS NOT NULL AND portal_access_status <> 'none')` [name: 'ck_party_contacts_portal_link_invariant']
  }
}

Table party_addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  party_id uuid [not null, note: 'Mitra bisnis pemilik penggunaan alamat']
  address_id uuid [not null, note: 'Referensi ke master addresses']
  usage address_usage_kind [not null, default: 'headquarters', note: 'billing, shipping, headquarters, registered_office, other']
  is_primary boolean [not null, default: false, note: 'Menandai alamat utama untuk kegunaan (usage) tersebut']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Asosiasi alamat mitra bisnis (misal membedakan alamat penagihan/billing dengan alamat gudang/lokasi operasional mitra untuk pengiriman atau pengambilan).'

  indexes {
    (party_id, address_id, usage) [unique, name: 'uq_party_addresses_party_addr_usage']
    (party_id, usage) [name: 'uq_party_addresses_primary_per_usage', note: 'Partial unique index PostgreSQL: UNIQUE (party_id, usage) WHERE (is_primary = TRUE)']
    address_id [name: 'ix_party_addresses_address']
  }
}

// ============================================================================
// 5. TRANSAKSI OUTBOX (SINKRONISASI KE IAM, PROCUREMENT, WMS, HRM)
// ============================================================================

Table foundation_outbox_events {
  id uuid [pk, default: `gen_random_uuid()`]
  event_type varchar(80) [not null, note: 'Contoh: legal_entity.status_changed, organization_unit.deactivated, location.deactivated, party.status_changed, party_contact.portal_revoked']
  aggregate_type varchar(40) [not null, note: 'legal_entity, organization_unit, location, party, party_contact']
  aggregate_id uuid [not null]
  payload jsonb [not null, default: `'{}'::jsonb`]
  status outbox_status [not null, default: 'pending']
  attempt_count int [not null, default: 0]
  next_retry_at timestamptz [not null, default: `now()`]
  last_error text
  processed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Antrean outbox transaksional untuk menyinkronkan perubahan status/penonaktifan master data ke IAM dan modul operasional tanpa FK lintas database.'

  indexes {
    (status, next_retry_at, created_at) [name: 'ix_foundation_outbox_pending']
    (aggregate_type, aggregate_id, created_at) [name: 'ix_foundation_outbox_aggregate']
  }
}

// ============================================================================
// 6. FOREIGN KEY REFERENCES (INTRA-DATABASE ENTERPRISE FOUNDATION)
// ============================================================================

// Struktur Internal Perusahaan
Ref: legal_entities.parent_legal_entity_id >? legal_entities.id [delete: set null]
Ref: legal_entities.registered_address_id >? addresses.id [delete: set null]

Ref: organization_units.legal_entity_id > legal_entities.id [delete: restrict]
Ref: organization_units.parent_unit_id >? organization_units.id [delete: set null]
Ref: organization_units.primary_location_id >? locations.id [delete: set null]

Ref: locations.legal_entity_id > legal_entities.id [delete: restrict]
Ref: locations.parent_location_id >? locations.id [delete: set null]
Ref: locations.address_id >? addresses.id [delete: restrict]

// Mitra Bisnis Eksternal
Ref: party_roles.party_id > parties.id [delete: cascade]
Ref: party_contacts.party_id > parties.id [delete: cascade]
Ref: party_addresses.party_id > parties.id [delete: cascade]
Ref: party_addresses.address_id > addresses.id [delete: restrict]
