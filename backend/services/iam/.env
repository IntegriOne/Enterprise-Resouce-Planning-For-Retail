# Konfigurasi runtime IAM IntegriOne (OS local time, PostgreSQL, gRPC, System IAM, Security)
TZ=Asia/Jakarta
APP_ENV=development
IAM_SERVICE_NAME=integrione-iam
IAM_SHUTDOWN_TIMEOUT_SECONDS=10

# Konfigurasi gRPC Server IAM
IAM_GRPC_HOST=0.0.0.0
IAM_GRPC_PORT=9001
IAM_GRPC_URL=127.0.0.1:9001

# Konfigurasi PostgreSQL IAM (host dev & docker compose)
IAM_POSTGRES_HOST=127.0.0.1
IAM_POSTGRES_PORT=6543
IAM_POSTGRES_USER=iam_management_svc
IAM_POSTGRES_PASSWORD=d931eeb77575bfc4c1b2b99e11807050529d2756c5d1d5d2
IAM_POSTGRES_DB=iam
IAM_DATABASE_DSN="postgres://iam_management_svc:d931eeb77575bfc4c1b2b99e11807050529d2756c5d1d5d2@127.0.0.1:6543/iam?sslmode=disable&TimeZone=Asia/Jakarta"
IAM_TEST_DATABASE_DSN="postgres://iam_management_svc:d931eeb77575bfc4c1b2b99e11807050529d2756c5d1d5d2@127.0.0.1:6543/iam_test?sslmode=disable&TimeZone=Asia/Jakarta"

# Identitas Principal System IAM (non-interactive system account)
IAM_SYSTEM_USER_UID=853aac77-32e7-4a88-b2d6-7d68db8d13d7
IAM_SYSTEM_USERNAME=systemiam
IAM_SYSTEM_EMAIL=systemiam@integrione.local
IAM_SYSTEM_PASSWORD=SysAdm#803ba6cef7c1!9Zx
IAM_SYSTEM_DISPLAY_NAME=SystemIAM
IAM_SYSTEM_USER_KIND=system
IAM_SYSTEM_ROLE_CODE=superadmin

# Konfigurasi Keamanan IAM (TOTP keyring, CSRF HMAC keyring, bukti internal Gateway, lockout policy, allowed redirects)
IAM_TOTP_KEYRING=1:oakYTBC467ImS8ubRYg8UEAgoRcBVUXwTUzneTFmfg8=
IAM_TOTP_ACTIVE_KEY_VERSION=1
IAM_TOTP_ISSUER="IntegriOne ERP"
IAM_CSRF_HMAC_KEYRING=1:Xsykq/dInAWPmUxSlKj4AQntAngzNSkak+aak6VrgUw=
IAM_CSRF_ACTIVE_KEY_VERSION=1
IAM_INTERNAL_GATEWAY_HMAC_SECRET=846cb1d36ca294f3d8a7bc98ec230ee4b7f7c492c044e69b966b6e606500bb7a
IAM_MAX_FAILED_LOGIN_ATTEMPTS=5
IAM_LOGIN_LOCK_DURATION_SECONDS=900
IAM_ALLOWED_REDIRECT_PATHS=/,/identity,/human-resource,/procurement,/warehouse,/finance,/accounting,/product,/supplier,/vendor,/commerce,/account,/profile

# Konfigurasi Redis Keamanan IAM (TLS wajib + ACL iam_writer; aktifkan true saat stack Redis berjalan)
IAM_REDIS_ENABLED=true
IAM_REDIS_ENV=development
IAM_REDIS_ADDR=127.0.0.1:6379
IAM_REDIS_USERNAME=iam_writer
IAM_REDIS_PASSWORD=ig_iam_dd97a17159dd5a21640c6517c9b9f30f0a906e32
IAM_REDIS_CA_CERT_PATH=../../deploy/certs/ca.crt
IAM_REDIS_SERVER_NAME=redis
IAM_REDIS_TLS_INSECURE_SKIP_VERIFY=false
