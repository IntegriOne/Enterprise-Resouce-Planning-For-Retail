# Konfigurasi runtime IAM IntegriOne (OS local time, PostgreSQL, gRPC, System IAM, Security)
TZ=Asia/Jakarta
APP_ENV=development
IAM_SERVICE_NAME=integrione-iam
IAM_SHUTDOWN_TIMEOUT_SECONDS=10

# Konfigurasi gRPC Server IAM
IAM_GRPC_HOST=0.0.0.0
IAM_GRPC_PORT=9001
IAM_GRPC_URL=127.0.0.1:9001

# Konfigurasi PostgreSQL IAM (host dev & docker compose)
IAM_POSTGRES_HOST=127.0.0.1
IAM_POSTGRES_PORT=6543
IAM_POSTGRES_USER=iam_management_svc
IAM_POSTGRES_PASSWORD=d931eeb77575bfc4c1b2b99e11807050529d2756c5d1d5d2
IAM_POSTGRES_DB=iam
IAM_DATABASE_DSN="postgres://iam_management_svc:d931eeb77575bfc4c1b2b99e11807050529d2756c5d1d5d2@127.0.0.1:6543/iam?sslmode=disable&TimeZone=Asia/Jakarta"
IAM_TEST_DATABASE_DSN="postgres://iam_management_svc:d931eeb77575bfc4c1b2b99e11807050529d2756c5d1d5d2@127.0.0.1:6543/iam_test?sslmode=disable&TimeZone=Asia/Jakarta"

