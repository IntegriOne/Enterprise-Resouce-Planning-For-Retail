# Konfigurasi lokal untuk layanan IAM gRPC + PostgreSQL (salin ke .env bila ingin override).
TZ=Asia/Jakarta
APP_ENV=development
IAM_SERVICE_NAME=integrione-iam
IAM_SHUTDOWN_TIMEOUT_SECONDS=10

# Endpoint dan port gRPC server IAM.
IAM_GRPC_HOST=0.0.0.0
IAM_GRPC_PORT=9001
IAM_GRPC_URL=127.0.0.1:9001

# Koneksi dan port PostgreSQL IAM (development & testing terisolasi).
IAM_POSTGRES_HOST=127.0.0.1
IAM_POSTGRES_PORT=5432
IAM_POSTGRES_USER=postgres
IAM_POSTGRES_PASSWORD=change_me_local_dev_password
IAM_POSTGRES_DB=iam
IAM_DATABASE_DSN="postgres://postgres:change_me_local_dev_password@127.0.0.1:5432/iam?sslmode=disable&TimeZone=Asia/Jakarta"
IAM_TEST_DATABASE_DSN="postgres://postgres:change_me_local_dev_password@127.0.0.1:5432/iam_test?sslmode=disable&TimeZone=Asia/Jakarta"

# Akun systemiam (non-interactive system principal / bootstrap IAM).
IAM_SYSTEM_USER_UID=00000000-0000-4000-8000-000000000001
IAM_SYSTEM_USERNAME=systemiam
IAM_SYSTEM_EMAIL=systemiam@integrione.local
IAM_SYSTEM_PASSWORD=Change_Me_System_IAM_2026!
IAM_SYSTEM_DISPLAY_NAME=SystemIAM
IAM_SYSTEM_USER_KIND=system
IAM_SYSTEM_ROLE_CODE=superadmin

# Konfigurasi keamanan TOTP & CSRF HMAC keyring, bukti internal Gateway, pembatasan login, dan redirect allowlist.
IAM_TOTP_KEYRING=
IAM_TOTP_ACTIVE_KEY_VERSION=1
IAM_TOTP_ISSUER="IntegriOne ERP"
IAM_CSRF_HMAC_KEYRING=
IAM_CSRF_ACTIVE_KEY_VERSION=1
IAM_INTERNAL_GATEWAY_HMAC_SECRET=change_me_internal_gateway_hmac_secret_min_32_bytes
IAM_MAX_FAILED_LOGIN_ATTEMPTS=5
IAM_LOGIN_LOCK_DURATION_SECONDS=900
IAM_ALLOWED_REDIRECT_PATHS=/,/identity,/human-resource,/procurement,/warehouse,/finance,/accounting,/product,/supplier,/vendor,/commerce,/account,/profile

# Konfigurasi Redis keamanan IAM (TLS + ACL iam_writer + noeviction).
IAM_REDIS_ENABLED=false
IAM_REDIS_ENV=development
IAM_REDIS_ADDR=127.0.0.1:6379
IAM_REDIS_USERNAME=iam_writer
IAM_REDIS_PASSWORD=change_me_iam_redis_writer_password
IAM_REDIS_CA_CERT_PATH=/etc/integrione/certs/ca.crt
IAM_REDIS_SERVER_NAME=redis
IAM_REDIS_TLS_INSECURE_SKIP_VERIFY=false

# Konfigurasi pengiriman email transaksional IAM (reset kata sandi & verifikasi email).
# Provider didukung: disabled, log, ses, smtp, sendgrid, resend, postmark.
IAM_EMAIL_PROVIDER=log
IAM_EMAIL_DELIVERY_MODE=async
IAM_EMAIL_FROM="IntegriOne Security <no-reply@integrione.local>"
IAM_EMAIL_REPLY_TO=
IAM_PUBLIC_BASE_URL=https://erp.localhost:8443
IAM_EMAIL_TIMEOUT_SECONDS=8
IAM_EMAIL_QUEUE_SIZE=256
IAM_EMAIL_WORKERS=2
IAM_EMAIL_MAX_ATTEMPTS=3

# Amazon SES v2 API (disarankan untuk production — mendukung IAM Role/IRSA/ECS maupun static key).
IAM_AWS_REGION=ap-southeast-1
IAM_AWS_ACCESS_KEY_ID=
IAM_AWS_SECRET_ACCESS_KEY=
IAM_AWS_SESSION_TOKEN=
IAM_AWS_SES_CONFIGURATION_SET=
IAM_AWS_SES_ENDPOINT=

# SMTP Universal (AWS SES SMTP email-smtp.<region>.amazonaws.com:587, SendGrid SMTP smtp.sendgrid.net:587, atau Mailpit dev).
IAM_SMTP_HOST=
IAM_SMTP_PORT=587
IAM_SMTP_USERNAME=
IAM_SMTP_PASSWORD=
IAM_SMTP_TLS_MODE=starttls
IAM_SMTP_SERVER_NAME=
IAM_SMTP_ALLOW_PLAINTEXT=false

# Third-party HTTP API (Twilio SendGrid v3 / Resend / Postmark).
IAM_EMAIL_API_KEY=
IAM_EMAIL_API_BASE_URL=
